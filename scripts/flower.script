	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end


function on_message(self, message_id, message, sender)
	if message_id == hash("selected") then
		if self.selected then
			if self.cycle == 3 then
				msg.post("/book#Herbbook", "harvest", {self.id})
				go.delete(self.circle)
				go.delete()
			else
				msg.post("/book#Herbbook", "unable", {1})
			end
		else
			self.selected = true
			go.animate(".", "euler.z", go.PLAYBACK_ONCE_FORWARD, 5, go.EASING_LINEAR, 0.25, 0, function()
				go.animate(".", "euler.z", go.PLAYBACK_ONCE_FORWARD, -5, go.EASING_LINEAR, 0.5, 0, function()
					go.animate(".", "euler.z", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_LINEAR, 0.25)
				end)
			end)
			timer.delay(1, false, function()
				self.selected = false
			end)
		end
	elseif message_id == hash("delete") then
		self.selection = nil
	elseif message_id == hash("harvested") then
		go.delete(self.circle)
		go.delete()
	end
end

