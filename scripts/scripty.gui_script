end

--y values:
--weather 1 = 970 weather 2 = 909 weather 3 = 843
local patternTime = 3600
--61 pixel diff

function update(self, dt)
	local time, pattern = seasons.getTime()
	gui.set(gui.get_node("needle"), gui.PROP_POSITION, vmath.vector3(-20, 970 - (61 * (pattern - 1 + (time / patternTime))), 0))

	local season = seasons.getSeason()
	if season == 1 then
		gui.play_flipbook(gui.get_node("season"), "spring", nil)
	elseif season == 2 then
		gui.play_flipbook(gui.get_node("season"), "summer", nil)
	elseif season == 3 then
		gui.play_flipbook(gui.get_node("season"), "autumn", nil)
	else
		gui.play_flipbook(gui.get_node("season"), "winter", nil)
	end
end

function on_message(self, message_id, message, sender)
	if not message_id == hash("escape") then
		gui.set_position(gui.get_node("info text"), vmath.vector3(960, 1140, 0))
	end
	if message_id == hash("unable") then
		gui.set_text(gui.get_node("info text"), "Not mature yet")
		gui.animate(gui.get_node("info text"), gui.PROP_POSITION, vmath.vector3(960, 1040, 0), gui.EASING_INSINE, .25, 0, function()
			timer.delay(.5, false, function()
				gui.animate(gui.get_node("info text"), gui.PROP_POSITION, vmath.vector3(960, 1140, 0), gui.EASING_INSINE, .25, 0)
			end)
		end)
	elseif message_id == hash("pollinate") then
		gui.set_text(gui.get_node("info text"), "Pick another flower!")
		gui.animate(gui.get_node("info text"), gui.PROP_POSITION, vmath.vector3(960, 1040, 0), gui.EASING_INSINE, .25, 0)
	elseif message_id == hash("escape") then
		gui.animate(gui.get_node("info text"), gui.PROP_POSITION, vmath.vector3(960, 1140, 0), gui.EASING_INSINE, .25, 0)
	elseif message_id == hash("harvest") then
		gui.set_text(gui.get_node("info text"), "Harvested " .. flowerInfo.ID(message[1])[1][1] .. "!")
		gui.animate(gui.get_node("info text"), gui.PROP_POSITION, vmath.vector3(960, 1040, 0), gui.EASING_INSINE, .25, 0, function()
			timer.delay(.5, false, function()
				gui.animate(gui.get_node("info text"), gui.PROP_POSITION, vmath.vector3(960, 1140, 0), gui.EASING_INSINE, .25, 0)
			end)
		end)
	end
end

function on_input(self, action_id, action)
	--local x, y, w, h = defos.get_window_size()
	--local ratio = 1920 / w
	local selectionTable = {gui.get_node("herbs"), gui.get_node("settings")}

	-- Bookmarks
	if screenSelection == 2 then
		local settingsTable = {"fullscreen", "mute"}
		for i, v in ipairs(settingsTable) do
			if gui.pick_node(gui.get_node(v), action.x, action.y) and action.pressed and action_id == hash("touch") then
				if gui.get_flipbook(gui.get_node(v)) == hash("unchecked") then
					gui.play_flipbook(gui.get_node(v), "checked", nil, {playback_rate = 0})
					gui.play_flipbook(gui.get_node(v .. 1), "checked", nil, {playback_rate = 0})
				else
					gui.play_flipbook(gui.get_node(v), "unchecked", nil, {playback_rate = 0})
					gui.play_flipbook(gui.get_node(v .. 1), "unchecked", nil, {playback_rate = 0})
				end
				if i == 1 then
					defos.toggle_fullscreen()
				else
					
				end
			end
		end	
		if gui.pick_node(gui.get_node("quitButton"), action.x, action.y) then
			gui.play_flipbook(gui.get_node("quitButton"), "hover", nil, {})
			if action.pressed and action_id == hash("touch") then
				flowerInfo.save()
				msg.post("@system:", "exit", {code = 0})
			end
		else
			gui.play_flipbook(gui.get_node("quitButton"), "initial", nil, {})
		end
	end

	-- Bookmark Traversal
	local base = gui.get_node("base")
	for i, v in ipairs(selectionTable) do
		if gui.pick_node(v, action.x, action.y) and screenSelection ~= i and not gui.pick_node(gui.get_node("page3"), action.x, action.y) then
			if action_id == hash("touch") and action.pressed then
				if i > screenSelection then
					right(0, i)
				else
					left(0, i)
				end
				page = 0
				screenSelection = i
				gui.animate(v, gui.PROP_POSITION, vmath.vector3(-124, gui.get_position(v).y, 0), gui.EASING_INSINE, .1, 0)
			else
				gui.animate(v, gui.PROP_POSITION, vmath.vector3(-115, gui.get_position(v).y, 0), gui.EASING_INSINE, .1, 0)
			end
		elseif screenSelection ~= i then
			gui.animate(v, gui.PROP_POSITION, vmath.vector3(-110, gui.get_position(v).y, 0), gui.EASING_INSINE, .1, 0)
		end
	end

	if inSeed or inScreen then
		if not (gui.pick_node(gui.get_node("seedbase"), action.x, action.y) or gui.pick_node(gui.get_node("base"), action.x, action.y)) and action.pressed then
			inSeed = false
			gui.animate(gui.get_node("seedbase"), gui.PROP_POSITION, vmath.vector3(-450, 540, 0), gui.EASING_INOUTSINE, 1)
			inScreen = nil
			mouseCheck.escapeGui()
			gui.animate(gui.get_node("bookmarks"), gui.PROP_POSITION, vmath.vector3(4, 0, 0), gui.EASING_INSINE, .5, 0)
			gui.animate(base, gui.PROP_POSITION, vmath.vector3(2600, 540, 0), gui.EASING_INOUTSINE, 1, 0, function()
				inScreen = false
			end)
		end
	end
	
	-- Opening the book
	if gui.pick_node(gui.get_node("herbbutton"), action.x, action.y) and action_id == hash("touch") and action.pressed then
		if inScreen == nil then
		
		elseif inScreen then
			inScreen = nil
			mouseCheck.escapeGui()
			gui.animate(gui.get_node("bookmarks"), gui.PROP_POSITION, vmath.vector3(4, 0, 0), gui.EASING_INSINE, .5, 0)
			gui.animate(base, gui.PROP_POSITION, vmath.vector3(2600, 540, 0), gui.EASING_INOUTSINE, 1, 0, function()
				inScreen = false
			end)
		else
			gui.animate(gui.get_node("info text"), gui.PROP_POSITION, vmath.vector3(960, 1140, 0), gui.EASING_INSINE, .25, 0)
			loadPage(page, screenSelection)
			updateAlamanc()
			inScreen = nil
			gui.animate(base, gui.PROP_POSITION, vmath.vector3(960, 540, 0), gui.EASING_INOUTSINE, 1, 0, function()
				inScreen = true
				gui.animate(gui.get_node("bookmarks"), gui.PROP_POSITION, vmath.vector3(0, 0, 0), gui.EASING_INSINE, .5, 0)
			end)
			mouseCheck.changeState(2)
		end
		gui.animate(gui.get_node("seedbase"), gui.PROP_POSITION, vmath.vector3(-450, 540, 0), gui.EASING_INOUTSINE, 1)
		inSeed = false
	end
	
	-- Inside the book, outside the book and other book-related functions
	if inScreen then
		local leftArrow = gui.get_node("leftArrow")
		local rightArrow = gui.get_node("rightArrow")
		local checkBox = gui.get_node("sortBox")
		
		if gui.pick_node(checkBox, action.x, action.y) and action.pressed and (action_id == hash("touch")) then
			insort = not insort
			if insort then
				gui.play_flipbook(checkBox, "checked")
			else
				gui.play_flipbook(checkBox, "unchecked")
			end
		end
		if insort then
			upAmount, dwAmount = flowerInfo.findNextUnlock(page, 1), flowerInfo.findNextUnlock(page, 0)
		else
			upAmount, dwAmount = 1, 1
		end
		if page == 0 and screenSelection == 1 then
			for i, v in ipairs(alamancTable) do
				if gui.pick_node(v, action.x, action.y) then
					loadRightPage1(flowerInfo.pageNum(alamancStorage[i + 3 * (alamancPage - 1)]), 1.5)
				end
			end
			if alamancPage == 1 then
				gui.play_flipbook(gui.get_node("alamancUp1"), "clicked")
			else
				gui.play_flipbook(gui.get_node("alamancUp1"), "initial")
				if gui.pick_node(gui.get_node("alamancUp1"), action.x, action.y) and action_id == hash("touch") and action.pressed then
					navigateAlamanc(0)
				end
			end
			if #alamancStorage <= 3 * (alamancPage + 2)  then
				gui.play_flipbook(gui.get_node("alamancDown1"), "clicked")
			else
				gui.play_flipbook(gui.get_node("alamancDown1"), "initial")
				if gui.pick_node(gui.get_node("alamancDown1"), action.x, action.y) and action_id == hash("touch") and action.pressed then
					navigateAlamanc(1)
				end
			end
		elseif flipcd or screenSelection ~= 1 then
		
		end
		if page == 0 or screenSelection == 2 or dwAmount == 0 then
			gui.play_flipbook(leftArrow, "clicked")
		elseif gui.pick_node(leftArrow, action.x, action.y) then
			if (action_id == hash("touch") and action.pressed) and not flipcd then
				gui.play_flipbook(leftArrow, "clicked")
				flipcd = true
				left(page - dwAmount, screenSelection)
			else
				gui.play_flipbook(leftArrow, "selected")
			end
		else
			gui.play_flipbook(leftArrow, "initial")
		end
		if screenSelection == 2 or page == flowerInfo.getSize() - 1 or upAmount == 0 then
			gui.play_flipbook(rightArrow, "clicked")
		elseif gui.pick_node(rightArrow, action.x, action.y) then
			if (action_id == hash("touch") and action.pressed) and not flipcd then
				gui.play_flipbook(rightArrow, "clicked")
				flipcd = true
				right(page + upAmount, screenSelection)
			else
				gui.play_flipbook(rightArrow, "selected")
			end
		else
			gui.play_flipbook(rightArrow, "initial")
		end
	elseif inSeed then
		
	else
		gui.play_flipbook(gui.get_node("seedbag"), "initial")
		if checkCollision({gui.get_node("seedbag1"), gui.get_node("seedbag2"), gui.get_node("seedbag3")}, action) then
			if action.pressed and action_id == hash("touch") then
				inSeed = true
				gui.animate(gui.get_node("seedbase"), gui.PROP_POSITION, vmath.vector3(450, 540, 0), gui.EASING_INOUTSINE, 1)
				downloadSeeds()
			else
				gui.play_flipbook(gui.get_node("seedbag"), "hover")
			end
		end
	end

	
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
