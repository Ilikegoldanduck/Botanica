function init(self)
	msg.post(".", "acquire_input_focus")
	msg.post("/flower_factory#flowery", "flowerselect", {uwu = 1})
	alamancTable = {gui.get_node("slot1"), gui.get_node("slot2"), gui.get_node("slot3"), gui.get_node("slot4"), gui.get_node("slot5"), gui.get_node("slot6"), gui.get_node("slot7"), gui.get_node("slot8"), gui.get_node("slot9")}
	alamancTable1 = {gui.get_node("slot"), gui.get_node("slot10"), gui.get_node("slot11"), gui.get_node("slot12"), gui.get_node("slot13"), gui.get_node("slot14"), gui.get_node("slot15"), gui.get_node("slot16"), gui.get_node("slot17")}
	seedTable = {gui.get_node("seedslot1"), gui.get_node("seedslot2"), gui.get_node("seedslot3"), gui.get_node("seedslot4"), gui.get_node("seedslot5"), gui.get_node("seedslot6"), gui.get_node("seedslot7"), gui.get_node("seedslot8"), gui.get_node("seedslot9")}
end

local function uploadSeeds()
	local tempstart = (seedPage - 1) * 9 + 1
	for i = 0, 8, 1 do
		local ref = seedTable[i + 1]
		if seedStorage[tempstart + i] then
			gui.set_visible(ref, true)
			gui.play_flipbook(ref, "1", nil, {playback_rate = 0})
			gui.set_flipbook_cursor(ref, (4 * seedStorage[tempstart + i][4] - 1) / 127)
		else
			gui.set_visible(ref, false)
		end
	end
end

local function downloadSeeds()
	local ceaser = seasons.getSeason()
	local weathertemp = nil
	if seasons.getWeather() >= 4 and seasons.getWeather() <= 9 then
		weathertemp = 5
	end
	seedStorage = flowerInfo.getAllSeasonWeather(ceaser, weathertemp)
	seedPage = 1
	uploadSeeds()
end

local function checkCollision(table, action)
	for i, v in ipairs(table) do
		if gui.pick_node(v, action.x, action.y) then
			return true
		end
	end
	return false
end

local function updateAlamanc()
	alamancStorage = flowerInfo.unlockTable()
end

local function navigateAlamanc(thing)
	if thing == 1 then
		alamancPage = alamancPage + 1
	elseif thing == 0 then
		alamancPage = alamancPage - 1
	end
	for i, p in ipairs(alamancStorage) do
		if i <= 3 * (alamancPage - 1) then
			
		elseif i > 3 * (alamancPage + 2) then
			break
		else
			local temp = i - 3 * (alamancPage - 1)
			gui.set_visible(alamancTable[temp], true)
			gui.play_flipbook(alamancTable[temp], "1", nil, {playback_rate = 0})
			gui.set_flipbook_cursor(alamancTable[temp], (4 * p - 1) / 127)
		end
	end
end

local function loadLeftPage1(p, c)
	
	gui.set_enabled(gui.get_node("alamanc1"), false)
	if c == 1 then
		gui.set_visible(gui.get_node("flowerbg"), false)
		if p > 0 then
			local flower = flowerInfo.ID(p)
			if flower[2] == 2 then
				gui.set_visible(gui.get_node("photo1"), true)
				gui.set_visible(gui.get_node("photo2"), true)
				gui.set_visible(gui.get_node("flower"), true)
				gui.play_flipbook(gui.get_node("flower"), "1", nil, {playback_rate = 0})
				gui.set_flipbook_cursor(gui.get_node("flower"), (4 * flower[1][4] - 1) / 127)
			else
				gui.set_visible(gui.get_node("photo1"), false)
				gui.set_visible(gui.get_node("photo2"), false)
				gui.set_visible(gui.get_node("flower"), false)
			end
		elseif p == 0 then
			gui.set_visible(gui.get_node("photo1"), false)
			gui.set_visible(gui.get_node("photo2"), false)
			gui.set_visible(gui.get_node("flower"), false)
			gui.set_visible(gui.get_node("flowerbg"), false)
			gui.set_enabled(gui.get_node("alamanc1"), true)
			for i, p in ipairs(alamancTable) do
				gui.set_visible(p, false)
			end
			for i, p in ipairs(alamancStorage) do
				if i >= 10 then
					break
				else
					gui.set_visible(alamancTable[i], true)
					gui.play_flipbook(alamancTable[i], "1", nil, {playback_rate = 0})
					gui.set_flipbook_cursor(alamancTable[i], (4 * p - 1) / 127)
					alamancPage = 1
				end
			end
		end
	elseif c == 2 then
		gui.set_visible(gui.get_node("photo1"), true)
		gui.set_visible(gui.get_node("photo2"), true)
		gui.set_visible(gui.get_node("flower"), false)
		gui.set_visible(gui.get_node("flowerbg"), true)
	end
end

local function loadLeftPage2(p, c)
	gui.set_enabled(gui.get_node("alamanc"), false)
	if c == 1 then
		gui.set_visible(gui.get_node("flowerbg1"), false)
		if p > 0 then
			local flower = flowerInfo.ID(p)
			if flower[2] == 2 then
				gui.set_visible(gui.get_node("photo3"), true)
				gui.set_visible(gui.get_node("photo4"), true)
				gui.set_visible(gui.get_node("flower1"), true)
				gui.play_flipbook(gui.get_node("flower1"), "1", nil, {playback_rate = 0})
				gui.set_flipbook_cursor(gui.get_node("flower1"), (4 * flower[1][4] - 1) / 127)
			else
				gui.set_visible(gui.get_node("photo3"), false)
				gui.set_visible(gui.get_node("photo4"), false)
				gui.set_visible(gui.get_node("flower1"), false)
			end
		elseif p == 0 then
			gui.set_visible(gui.get_node("photo3"), false)
			gui.set_visible(gui.get_node("photo4"), false)
			gui.set_visible(gui.get_node("flower1"), false)
			gui.set_visible(gui.get_node("flowerbg"), false)
			gui.set_enabled(gui.get_node("alamanc"), true)
			for i, p in ipairs(alamancTable1) do
				gui.set_visible(p, false)
			end
			for i, p in ipairs(alamancStorage) do
				if i >= 10 then
					break
				else
					gui.set_visible(alamancTable1[i], true)
					gui.play_flipbook(alamancTable1[i], "1", nil, {playback_rate = 0})
					gui.set_flipbook_cursor(alamancTable1[i], (4 * p - 1) / 127)
				end
			end
		end
	elseif c == 2 then
		gui.set_visible(gui.get_node("photo3"), true)
		gui.set_visible(gui.get_node("photo4"), true)
		gui.set_visible(gui.get_node("flower1"), false)
		gui.set_visible(gui.get_node("flowerbg1"), true)
	end
end

